# =========================================================
# Apolodigital-Dental - Plantilla de Configuración de Entorno (.env.example)
# =========================================================
# Instrucciones:
# 1. Copia este archivo a .env: cp .env.example .env
# 2. Genera claves criptográficas seguras: python scripts/generate_secrets.py
# 3. NUNCA commitees .env al repositorio Git.
# =========================================================

PROJECT_NAME="Apolodigital-Dental"
ENVIRONMENT="development"  # Options: development, staging, production

# Base de Datos (PostgreSQL Asíncrono)
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/dental_db
# Railway: postgresql+asyncpg://usuario:password@host:port/database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/dental_db"

# Claves Criptográficas de Firma JWT (Mínimo 64 caracteres hexadecimales / 32 bytes)
# Generar con: python scripts/generate_secrets.py
JWT_SECRET="GENERAR_CON_SCRIPTS_GENERATE_SECRETS_PY_MINIMO_32_CHARS"
JWT_REFRESH_SECRET="GENERAR_CON_SCRIPTS_GENERATE_SECRETS_PY_MINIMO_32_CHARS"

# FASE 2: Tiempos de expiración de sesión y seguridad (RTR + MFA)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_PENDING_EXPIRE_MINUTES=10

# Caché y Rate Limiting distribuido (Redis opcional con fallback en memoria)
REDIS_URL=""
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_RESET_MAX=5
RATE_LIMIT_RESET_WINDOW_SECONDS=3600

# Token de seguridad para sondas CI / Healthchecks sensibles (/health/deep)
CI_SECRET_TOKEN="TOKEN_SECRETO_PARA_MONITOREO_Y_PIPELINE"

# Dominios permitidos por CORS (En producción especificar dominios explícitos)
CORS_ORIGINS='["http://localhost:5173","https://dental-frontend.edwinjrivero.workers.dev"]'

# Integración Meta WhatsApp Cloud API (Graph API)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v20.0"
